<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup><IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Domain/DeckCapture.Domain.csproj" />
    <ProjectReference Include="../Capture/DeckCapture.Capture.csproj" />
    <ProjectReference Include="../Delivery/DeckCapture.Delivery.csproj" />
    <ProjectReference Include="../CaptureWorker/DeckCapture.CaptureWorker.csproj" ReferenceOutputAssembly="false" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.14" />
    <PackageReference Include="MailKit" Version="4.18.2" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>
  <!-- The worker is a separate process, so a normal assembly reference would omit its runtime files. -->
  <Target Name="CopyCaptureWorker" AfterTargets="Build">
    <PropertyGroup>
      <WorkerBuildOutput>../CaptureWorker/bin/$(Configuration)/$(TargetFramework)/</WorkerBuildOutput>
      <WorkerBuildOutput Condition="'$(RuntimeIdentifier)' != ''">$(WorkerBuildOutput)$(RuntimeIdentifier)/</WorkerBuildOutput>
    </PropertyGroup>
    <!-- Worker dependencies/runtime files are at the output root or in runtimes/. Do not
         recursively copy unrelated RID or stale publish directories from a non-RID build. -->
    <ItemGroup><WorkerFiles Include="$(WorkerBuildOutput)*;$(WorkerBuildOutput)runtimes/**/*" /></ItemGroup>
    <Copy SourceFiles="@(WorkerFiles)" DestinationFiles="@(WorkerFiles->'$(TargetDir)capture-worker/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishCaptureWorker" AfterTargets="Publish">
    <ItemGroup><PublishedWorkerFiles Include="$(TargetDir)capture-worker/**/*" /></ItemGroup>
    <Copy SourceFiles="@(PublishedWorkerFiles)" DestinationFiles="@(PublishedWorkerFiles->'$(PublishDir)capture-worker/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
